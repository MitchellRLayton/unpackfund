{
  // The Worker that Workers Builds deploys on every push to `main`.
  //
  // It is not production and owns no domain. It exists because the Git build runs
  // `pnpm build` → `npx wrangler deploy`, which reads *this* file and cannot generate
  // the 9,016 fund pages (that needs Python, the pipeline, and a release). On 2026-10-30
  // that limitation published a shell-only site over unpackfund.com and took the fund
  // pages down with it. Pointing the unprefixed deploy at a throwaway Worker keeps the
  // Git build useful as a "does main still compile" canary while making it structurally
  // unable to touch production: publishing the real site needs
  // `--config wrangler.prod.jsonc` and the pages that go with it.
  //
  // Production deploys: `.github/workflows/deploy-site.yml` (code, on push to main and
  // after a successful promote), `.github/workflows/promote.yml` (the reviewed data
  // artefact, nightly), or `pnpm deploy:prod` by hand.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unpackfund-buildcheck",
  "compatibility_date": "2026-10-28",
  // Deliberately not the built site. Workers Builds pins the Worker on Cloudflare's
  // side, so renaming this file's Worker did not move the deploy target (measured
  // 2026-10-31: a Git build published a page-less version over production 93 s after a
  // complete deploy). What is left is the assets: a directory that never exists, so any
  // deploy that reads this config fails loudly instead of publishing half a site.
  // `wrangler.prod.jsonc` is the one that ships.
  "assets": {
    "directory": "./web/out-requires-fund-pages",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
