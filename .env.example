# Copy to .env and fill in. Never commit real values; .env is git-ignored.
# SEC requires a descriptive User-Agent with contact details.
SEC_USER_AGENT="UnpackFund research you@example.com"

# Cloudflare account and a token scoped to what the script needs.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 S3 API credentials for artifact uploads (bucket-scoped).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=unpackfund-artifacts
