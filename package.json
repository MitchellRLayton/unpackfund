{
  "name": "unpackfund",
  "version": "0.0.0",
  "private": true,
  "description": "Fund portfolio X-ray: look through an ETF to the companies you actually own.",
  "license": "MIT",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @unpackfund/web dev",
    "build": "pnpm --filter @unpackfund/web build",
    "lint": "pnpm --filter @unpackfund/web lint",
    "typecheck": "pnpm --filter @unpackfund/web typecheck",
    "test": "pnpm --filter @unpackfund/web test",
    "format": "pnpm --filter @unpackfund/web format",
    "check:determinism": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.checks",
    "pipeline:build": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.build",
    "pipeline:test": "cd pipeline && ../.venv/pipeline/bin/python -m pytest",
    "refresh:detect": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.refresh detect",
    "data:validate": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.validate",
    "release:upload": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.release upload",
    "release:verify": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.release verify",
    "release:promote": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.release promote",
    "data:review": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.review",
    "data:triage": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.triage",
    "data:retention": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.retention",
    "verify:live": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.live",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm pipeline:test && pnpm data:validate --fixtures && pnpm build",
    "pages:funds": "cd pipeline && ../.venv/pipeline/bin/python -m pipeline.fund_pages --out ../web/out",
    "build:site": "pnpm build && pnpm pages:funds",
    "deploy:preview": "npx --yes wrangler@4.155.0 deploy --config wrangler.preview.jsonc",
    "deploy:prod": "npx --yes wrangler@4.155.0 deploy --config wrangler.jsonc"
  }
}
