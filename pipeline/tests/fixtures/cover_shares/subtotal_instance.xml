<?xml version="1.0" encoding="UTF-8"?>
<!--
  The subtotal trap, in Visa's shape: a combined class fact beside the two classes
  it is the sum of. 300,000,000 + 30,000,000 = 330,000,000, so the combined fact
  is a subtotal and summing all three would count the B shares twice.
-->
<xbrli:xbrl xmlns:xbrli="http://www.xbrl.org/2003/instance"
            xmlns:dei="http://xbrl.sec.gov/dei/2024"
            xmlns:us-gaap="http://fasb.org/us-gaap/2024"
            xmlns:xbrldi="http://xbrl.org/2006/xbrldi"
            xmlns:v="http://www.visa.com/20240930"
            xmlns:link="http://www.xbrl.org/2003/linkbase"
            xmlns:xlink="http://www.w3.org/1999/xlink">

  <link:schemaRef xlink:type="simple" xlink:href="v-20240930.xsd"/>

  <xbrli:context id="C-b1">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.sec.gov/CIK">0001403161</xbrli:identifier>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:instant>2024-10-25</xbrli:instant>
    </xbrli:period>
    <xbrli:scenario>
      <xbrldi:explicitMember dimension="us-gaap:StatementClassOfStockAxis">v:CommonClassB1Member</xbrldi:explicitMember>
    </xbrli:scenario>
  </xbrli:context>

  <xbrli:context id="C-b2">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.sec.gov/CIK">0001403161</xbrli:identifier>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:instant>2024-10-25</xbrli:instant>
    </xbrli:period>
    <xbrli:scenario>
      <xbrldi:explicitMember dimension="us-gaap:StatementClassOfStockAxis">v:CommonClassB2Member</xbrldi:explicitMember>
    </xbrli:scenario>
  </xbrli:context>

  <xbrli:context id="C-b1-and-b2">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.sec.gov/CIK">0001403161</xbrli:identifier>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:instant>2024-10-25</xbrli:instant>
    </xbrli:period>
    <xbrli:scenario>
      <xbrldi:explicitMember dimension="us-gaap:StatementClassOfStockAxis">v:CommonClassB1AndB2Member</xbrldi:explicitMember>
    </xbrli:scenario>
  </xbrli:context>

  <xbrli:unit id="shares">
    <xbrli:measure>xbrli:shares</xbrli:measure>
  </xbrli:unit>

  <dei:EntityCommonStockSharesOutstanding contextRef="C-b1" unitRef="shares" decimals="0">300000000</dei:EntityCommonStockSharesOutstanding>
  <dei:EntityCommonStockSharesOutstanding contextRef="C-b2" unitRef="shares" decimals="0">30000000</dei:EntityCommonStockSharesOutstanding>
  <dei:EntityCommonStockSharesOutstanding contextRef="C-b1-and-b2" unitRef="shares" decimals="0">330000000</dei:EntityCommonStockSharesOutstanding>

</xbrli:xbrl>
