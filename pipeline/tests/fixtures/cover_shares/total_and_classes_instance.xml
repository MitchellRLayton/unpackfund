<?xml version="1.0" encoding="UTF-8"?>
<!--
  A filer that states both: an undimensioned total and the class breakdown. The
  total is the answer — summing the classes would be the same number only if the
  breakdown were complete, and the point of the rule is not to have to assume it.
-->
<xbrli:xbrl xmlns:xbrli="http://www.xbrl.org/2003/instance"
            xmlns:dei="http://xbrl.sec.gov/dei/2024"
            xmlns:us-gaap="http://fasb.org/us-gaap/2024"
            xmlns:xbrldi="http://xbrl.org/2006/xbrldi"
            xmlns:acme="http://www.acme.com/20240928"
            xmlns:link="http://www.xbrl.org/2003/linkbase"
            xmlns:xlink="http://www.w3.org/1999/xlink">

  <link:schemaRef xlink:type="simple" xlink:href="acme-20240928.xsd"/>

  <xbrli:context id="C-total">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.sec.gov/CIK">0000000005</xbrli:identifier>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:instant>2024-09-28</xbrli:instant>
    </xbrli:period>
  </xbrli:context>

  <xbrli:context id="C-class-a">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.sec.gov/CIK">0000000005</xbrli:identifier>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:instant>2024-09-28</xbrli:instant>
    </xbrli:period>
    <xbrli:scenario>
      <xbrldi:explicitMember dimension="us-gaap:StatementClassOfStockAxis">acme:CommonClassAMember</xbrldi:explicitMember>
    </xbrli:scenario>
  </xbrli:context>

  <xbrli:context id="C-class-b">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.sec.gov/CIK">0000000005</xbrli:identifier>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:instant>2024-09-28</xbrli:instant>
    </xbrli:period>
    <xbrli:scenario>
      <xbrldi:explicitMember dimension="us-gaap:StatementClassOfStockAxis">acme:CommonClassBMember</xbrldi:explicitMember>
    </xbrli:scenario>
  </xbrli:context>

  <xbrli:unit id="shares">
    <xbrli:measure>xbrli:shares</xbrli:measure>
  </xbrli:unit>

  <dei:EntityCommonStockSharesOutstanding contextRef="C-total" unitRef="shares" decimals="0">2000000000</dei:EntityCommonStockSharesOutstanding>
  <dei:EntityCommonStockSharesOutstanding contextRef="C-class-a" unitRef="shares" decimals="0">1500000000</dei:EntityCommonStockSharesOutstanding>
  <dei:EntityCommonStockSharesOutstanding contextRef="C-class-b" unitRef="shares" decimals="0">400000000</dei:EntityCommonStockSharesOutstanding>

</xbrli:xbrl>
