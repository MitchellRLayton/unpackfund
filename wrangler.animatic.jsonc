{
  // Phase-1 review target. A separate Worker from production `unpackfund`;
  // nothing here can publish unpackfund.com.
  "name": "unpackfund-animatic",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./intro/dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": false }
}
